<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FOCTTA iOS SDK privacy manifest.
  Required for App Store submission since Feb 2025 (Required Reason APIs).

  We declare:
    - UserDefaults access (reason C56.1 — accessing user defaults for
      content provided by the user). Used for IdempotencyStore + ConfigStore.
    - File timestamp APIs (reason CA92.1 — accessing files in the app's
      sandbox). Used for receipt/queue file persistence.
    - No tracking. The SDK explicitly does NOT collect any of:
      - IDFA / advertising id (the ATT helper SURFACES the result to the
        caller; it doesn't transmit it to FOCTTA)
      - Device fingerprint / advanced identifier
      - Coarse/precise location
      - Crash data (left to the host app's Crashlytics/Sentry)

  NSPrivacyCollectedDataTypes is intentionally empty: we receive a
  pseudonymous data_principal_id from the caller and a consent record;
  neither is "data collection" in App Privacy Manifest terminology since
  the customer's app is the data controller, not FOCTTA.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
